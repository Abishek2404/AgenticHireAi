{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "npm run build --prefix client",
  "outputDirectory": "client/.next",
  "installCommand": "npm install --prefix client && npm install --prefix server",
  "framework": "nextjs",
  "functions": {
    "api/[...path].js": {
      "maxDuration": 60
    }
  }
}
